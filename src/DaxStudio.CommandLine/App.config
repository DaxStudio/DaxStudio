<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
	</startup>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<probing privatePath="bin"/>
		</assemblyBinding>
		<!-- Binding redirects for net472 are generated automatically at build time via
		     AutoGenerateBindingRedirects (see the .csproj). Do not hand-maintain them here.
		     Only the probing path is kept, as it is not emitted by auto-generation. -->
	</runtime>
</configuration>
