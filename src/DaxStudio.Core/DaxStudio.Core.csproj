<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net8.0-windows</TargetFrameworks>
    <RunAnalyzersDuringBuild>False</RunAnalyzersDuringBuild>
    <EnforceCodeStyleInBuild>False</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>..\..\Release\bin\</OutputPath>
  </PropertyGroup>

  <!-- Linked files from parent directory -->
  <ItemGroup>
    <Compile Include="..\CommonAssemblyInfo.cs" Link="Properties\CommonAssemblyInfo.cs" />
    <Compile Include="..\CommonAssemblyVersion.cs" Link="Properties\CommonAssemblyVersion.cs" />
  </ItemGroup>

  <!-- Project references -->
  <ItemGroup>
    <ProjectReference Include="..\ADOTabular\DaxStudio.ADOTabular.csproj" />
    <ProjectReference Include="..\DaxStudio.Common\DaxStudio.Common.csproj" />
    <ProjectReference Include="..\DaxStudio.Interfaces\DaxStudio.Interfaces.csproj" />
    <ProjectReference Include="..\DaxStudio.Parsers\DaxStudio.Parsers.csproj" />
    <ProjectReference Include="..\DaxStudio.QueryTrace\DaxStudio.QueryTrace.csproj" />
    <ProjectReference Include="..\DaxStudio.SqlFormatter\DaxStudio.SqlFormatter.csproj" />
  </ItemGroup>

  <!-- Framework references -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Management" />
  </ItemGroup>
  <!-- System.Management (WMI) is Windows-only; scope it to the Windows TFMs so a future plain
       net8.0 (cross-platform) target never references it. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <!-- Windows-only Power BI Desktop discovery code (WMI / iphlpapi / user32 / WindowsPrincipal).
       Forward-looking: these are excluded from a future plain net8.0 target, which instead
       compiles PowerBIScannerFactory.Stub.cs. Today (net472; net8.0-windows only) these are
       no-ops but they document intent and make the eventual net8.0 flip a one-line change. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="Extensions\ProcessExtensions.cs" />
    <Compile Remove="Utils\ManagedIpHelper.cs" />
    <Compile Remove="Utils\WindowsPowerBIInstanceScanner.cs" />
    <Compile Remove="Utils\PowerBIScannerFactory.Windows.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
    <Compile Remove="Utils\PowerBIScannerFactory.Stub.cs" />
  </ItemGroup>

  <!-- Package references -->
  <ItemGroup>
    <PackageReference Include="AsyncAwaitBestPractices" />
    <PackageReference Include="Caliburn.Micro" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Dax.Model.Extractor" />
    <PackageReference Include="Dax.ViewVpaExport" />
    <PackageReference Include="Dax.Vpax" />
    <PackageReference Include="Dax.Vpax.Obfuscator" />
    <PackageReference Include="LargeXlsx" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Parquet.Net" />
    <PackageReference Include="Polly" />
    <PackageReference Include="System.ComponentModel.Composition" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DaxStudio.UI" />
    <InternalsVisibleTo Include="DaxStudio.Tests" />
  </ItemGroup>


</Project>
