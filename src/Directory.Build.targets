<Project>
  <!-- .NET SDK 10.0 adds GeneratedAssemblyInfoFile to the compile list even when
       all individual assembly attributes are suppressed. Ensure the file exists. -->
  <Target Name="_EnsureGeneratedAssemblyInfoFile" 
          BeforeTargets="CoreCompile" 
          AfterTargets="GenerateAssemblyInfo"
          Condition="'$(GeneratedAssemblyInfoFile)' != '' and !Exists('$(GeneratedAssemblyInfoFile)')">
    <WriteLinesToFile File="$(GeneratedAssemblyInfoFile)" Lines="" Overwrite="true" />
  </Target>

   <Target Name="DisableAnalyzers" 
           BeforeTargets="CoreCompile" 
           Condition="'$(UseRoslynAnalyzers)' == 'false'"> 
     <!-- 
       Disable analyzers via an MSBuild property settable on the command line. 
     --> 
     <ItemGroup> 
       <Analyzer Remove="@(Analyzer)" /> 
     </ItemGroup> 
   </Target> 

  <!-- Inject the global System.Resources.Extensions PackageReference (needed to build
       non-string .resx under the .NET SDK) via a CONDITIONAL IMPORT rather than a
       conditioned ItemGroup. Legacy packages.config projects (the VSTO Excel add-in, which
       has ManagePackageVersionsCentrally disabled) are excluded here: when the import
       condition is false the file is never loaded, so Visual Studio's NuGet nomination
       cannot observe the PackageReference. A conditioned ItemGroup was not sufficient - VS
       still collected the versionless item, causing NU1015 and mis-detecting the project as
       PackageReference-style (hiding its packages.config packages). -->
  <Import Project="SystemResourcesExtensions.targets"
          Condition="'$(ProjectTypeGuids)' == '' and !Exists('$(MSBuildProjectDirectory)\packages.config')" />
</Project>
