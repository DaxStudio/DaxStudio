<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Parlot preview builds, until the version used by DaxStudio.Parsers is on nuget.org -->
    <add key="parlot-previews" value="https://f.feedz.io/sebastienros/parlot/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="parlot-previews">
      <package pattern="Parlot" />
    </packageSource>
  </packageSourceMapping>
</configuration>
