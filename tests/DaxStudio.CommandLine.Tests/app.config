<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- Binding redirects for net472 are generated automatically at build time via
         AutoGenerateBindingRedirects / GenerateBindingRedirectsOutputType (see the .csproj).
         Do not hand-maintain them here. Only the probing path is kept, as it is not emitted
         by auto-generation. -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <probing privatePath="bin" />
    </assemblyBinding>
  </runtime>
</configuration>
